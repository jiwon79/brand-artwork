INSTAGRAM_ENV=development
META_DEV_APP_ID=your_development_instagram_app_id
META_DEV_APP_SECRET=your_development_instagram_app_secret
META_DEV_REDIRECT_URI=https://your-dev-host.example/api/auth/callback
META_DEV_WEBHOOK_VERIFY_TOKEN=generate_a_long_random_value
META_PROD_APP_ID=your_production_instagram_app_id
META_PROD_APP_SECRET=your_production_instagram_app_secret
META_PROD_REDIRECT_URI=https://your-production-host.example/api/auth/callback
META_PROD_WEBHOOK_VERIFY_TOKEN=generate_a_different_long_random_value
INSTAGRAM_GRAPH_VERSION=v25.0
TURSO_DRIVER=libsql
TURSO_DEV_DATABASE_URL=libsql://your-development-database.turso.io
TURSO_DEV_AUTH_TOKEN=your_development_database_token
TURSO_PROD_DATABASE_URL=libsql://your_production_database.turso.io
TURSO_PROD_AUTH_TOKEN=your_production_database_token
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
