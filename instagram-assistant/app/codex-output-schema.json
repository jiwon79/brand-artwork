{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "action", "confidence", "draft", "artwork_slug", "reason"],
  "properties": {
    "intent": {"type": "string"},
    "action": {"enum": ["ignore", "reply_comment", "reply_dm", "manual_review"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "draft": {"type": "string"},
    "artwork_slug": {"type": ["string", "null"]},
    "reason": {"type": "string"}
  }
}
