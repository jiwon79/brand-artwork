        <mxCell id="title" value="접촉은 81곳에서 검사하고, 움직임은 글자 전체에 한 번만 적용한다" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=27;fontStyle=1;fontFamily=Arial;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1120" height="42" as="geometry" />
        </mxCell>
        <mxCell id="head-1" value="1. 픽셀을 따로 움직이면" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="50" y="105" width="310" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub-1" value="같은 글자 안에서도 이동 거리가 달라진다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontFamily=Arial;fontColor=#5F6F84;" vertex="1" parent="1">
          <mxGeometry x="50" y="133" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="head-2" value="2. 9 × 9 접촉 검사점" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="445" y="105" width="310" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub-2" value="가상의 81개 좌표에서 접촉만 확인한다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontFamily=Arial;fontColor=#5F6F84;" vertex="1" parent="1">
          <mxGeometry x="445" y="133" width="310" height="24" as="geometry" />
        </mxCell>
        <mxCell id="head-3" value="3. 글자 전체에 적용" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontFamily=Arial;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="840" y="105" width="310" height="28" as="geometry" />
        </mxCell>
        <mxCell id="sub-3" value="81개 결과로 offset 하나와 angle 하나를 만든다" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontFamily=Arial;fontColor=#5F6F84;" vertex="1" parent="1">
          <mxGeometry x="840" y="133" width="310" height="24" as="geometry" />
        </mxCell>
