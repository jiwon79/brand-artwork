    { "name": "two-foreground-grips", "starts": [[170, 645], [425, 645]], "movesBy": [[-90, 0], [90, 0]], "grips": 2, "byBody": [0, 0, 2], "fields": 8, "materialScale": 0.845154 },
    { "name": "five-grips", "starts": [[321, 145], [274, 1120], [155, 600], [298, 700], [435, 610]], "movesBy": [[-70, 45], [80, -45], [-75, -25], [0, 85], [80, -20]], "grips": 5, "byBody": [1, 1, 3], "fields": 20, "materialScale": 0.620174 }
