{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "vite.config.ts",
    "common/touch-cursor.ts",
    "common/touch-pointer.ts",
    "pages/cursor-cat-circle/**/*.ts",
    "pages/color-text/**/*.ts",
    "pages/guseul/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
